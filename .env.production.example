# Copy this file to /opt/betterspend/.env.production on the server.
# Keep the server copy out of git.

# Public domains
BETTERSPEND_DOMAIN=example.com
MINIO_PUBLIC_ENDPOINT=https://files.example.com

# Images are normally supplied by GitHub Actions through IMAGE_TAG.
API_IMAGE=ghcr.io/your-org/betterspend-api
WEB_IMAGE=ghcr.io/your-org/betterspend-web
MIGRATOR_IMAGE=ghcr.io/your-org/betterspend-migrator

# Database
POSTGRES_USER=betterspend
POSTGRES_PASSWORD=change-me
POSTGRES_DB=betterspend
DATABASE_URL=postgresql://betterspend:change-me@postgres:5432/betterspend

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# S3-compatible object storage
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=betterspend
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=betterspend
MINIO_REGION=us-east-1
MINIO_ROOT_USER=betterspend
MINIO_ROOT_PASSWORD=change-me

# SES inbound email. The API maintains a 90-day lifecycle on this raw MIME prefix.
EMAIL_INTAKE_DOMAIN=inbound.example.com
EMAIL_INTAKE_RAW_PREFIX=email-intake/raw/
EMAIL_INTAKE_WEBHOOK_SECRET=change-me-use-openssl-rand-hex-32
EMAIL_INTAKE_SMTP_HOST=
EMAIL_INTAKE_SMTP_PORT=587
EMAIL_INTAKE_SMTP_SECURE=false
EMAIL_INTAKE_SMTP_USER=
EMAIL_INTAKE_SMTP_PASS=
EMAIL_INTAKE_SMTP_FROM=noreply@example.com

# Auth and encryption
BETTER_AUTH_SECRET=change-me-use-openssl-rand-hex-32
DEMO_MODE=false
# Generate with: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=

# Optional accounting OAuth applications
# Callback URLs are derived from API_URL:
#   https://example.com/api/v1/gl/oauth/qbo/callback
#   https://example.com/api/v1/gl/oauth/xero/callback
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
# QBO inbound sync. The webhook verifier token is configured in the Intuit app.
QBO_SYNC_INTERVAL_MS=3600000
QBO_CDC_CRON=0 2 * * *
QBO_WEBHOOK_VERIFIER_TOKEN=
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# App URLs
API_PORT=4001
API_URL=https://example.com
WEB_URL=https://example.com
