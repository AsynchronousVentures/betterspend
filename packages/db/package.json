{
  "name": "@betterspend/db",
  "version": "0.2.3",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --max-warnings 0",
    "db:generate": "drizzle-kit generate",
    "db:validate-history": "tsx src/validate-migration-history.ts",
    "db:migrate": "tsx src/migrate.ts",
    "db:verify-migrations": "tsx src/verify-migrations.ts",
    "db:verify-auth-upgrade": "tsx src/verify-auth-upgrade.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/seed.ts",
    "db:seed:random": "tsx src/random-seed-cli.ts",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@betterspend/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.15",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.12",
    "typescript": "^5.7.0"
  }
}
