{
  "name": "betterspend",
  "version": "0.2.3",
  "private": true,
  "pnpm": {
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "0.25.12",
      "@hono/node-server": "1.19.15",
      "deepmerge-ts": "8.0.2",
      "effect": "3.20.0",
      "hono": "4.12.34",
      "lodash": "4.18.1",
      "next>sharp": "0.35.4",
      "postcss": "8.5.26",
      "uuid": "11.1.1",
      "valibot": "1.4.2"
    }
  },
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "prepare": "node .husky/install.mjs",
    "dev": "turbo dev",
    "prototype:punchout": "pnpm --filter @betterspend/web dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "ci:preflight": "node scripts/ci-preflight.mjs",
    "ci:preflight:docker": "node scripts/ci-preflight.mjs --docker",
    "db:generate": "turbo db:generate",
    "db:migrate": "turbo db:migrate",
    "db:seed": "turbo db:seed",
    "db:seed:random": "pnpm --filter @betterspend/db db:seed:random --",
    "db:studio": "turbo db:studio",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "release:tag": "node scripts/release-tag.mjs",
    "release:push": "git push origin main --follow-tags"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.3",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "turbo": "^2.10.11",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.67.0"
  }
}
