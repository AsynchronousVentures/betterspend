{
  "name": "betterspend",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "db:generate": "turbo db:generate",
    "db:migrate": "turbo db:migrate",
    "db:seed": "turbo db:seed",
    "db:seed:random": "pnpm --filter @betterspend/db db:seed:random --",
    "db:studio": "turbo db:studio",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "release:tag": "git tag -a v$npm_package_version -m \"Release v$npm_package_version\"",
    "release:push": "git push origin main --follow-tags"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.21",
    "prettier": "^3.9.6",
    "turbo": "^2.10.11",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.67.0"
  }
}
