# Database
DATABASE_URL=postgresql://betterspend:betterspend@localhost:5433/betterspend

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# S3 / MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=betterspend
MINIO_REGION=us-east-1

# Legacy S3 aliases are still accepted by the API.
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=betterspend
S3_REGION=us-east-1

# Auth
BETTER_AUTH_SECRET=change-me-in-production-use-openssl-rand-hex-32
# Allows unauthenticated access as the seeded demo user. Never enable in production.
DEMO_MODE=false
# Encrypts all stored third-party credentials. Generate with: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=

# URLs used by the API at runtime
API_PORT=4001
API_URL=http://localhost:4001
WEB_URL=http://localhost:3100
# Optional web-image build setting for a separate API origin. Official images
# leave this unset and send browser requests to the web app's own origin.
NEXT_PUBLIC_API_URL=http://localhost:4001
