# Database
DATABASE_URL=postgresql://betterspend:betterspend@localhost:5433/betterspend

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# S3 / MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=betterspend
MINIO_REGION=us-east-1

# Legacy S3 aliases are still accepted by the API.
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=betterspend
S3_REGION=us-east-1

# SES inbound email. Configure the SES S3 receipt action with this prefix.
EMAIL_INTAKE_DOMAIN=inbound.example.com
EMAIL_INTAKE_RAW_PREFIX=email-intake/raw/
EMAIL_INTAKE_WEBHOOK_SECRET=change-me-use-openssl-rand-hex-32
EMAIL_INTAKE_SMTP_HOST=
EMAIL_INTAKE_SMTP_PORT=587
EMAIL_INTAKE_SMTP_SECURE=false
EMAIL_INTAKE_SMTP_USER=
EMAIL_INTAKE_SMTP_PASS=
EMAIL_INTAKE_SMTP_FROM=noreply@example.com

# Auth
BETTER_AUTH_SECRET=change-me-in-production-use-openssl-rand-hex-32
# Allows unauthenticated access as the seeded demo user. Never enable in production.
DEMO_MODE=false
# Encrypts stored accounting OAuth tokens and AI credentials.
# Generate with: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=

# URLs used by the API at runtime
API_PORT=4001
API_URL=http://localhost:4001
# QBO inbound sync. The webhook verifier token is configured in the Intuit app.
QBO_SYNC_INTERVAL_MS=3600000
QBO_CDC_CRON=0 2 * * *
QBO_WEBHOOK_VERIFIER_TOKEN=
# pnpm dev serves the web app on 3000. The local container override uses 3100.
WEB_URL=http://localhost:3000
# Local web build setting. Official production images leave this unset and send
# browser requests to the web app's own origin.
NEXT_PUBLIC_API_URL=http://localhost:4001
